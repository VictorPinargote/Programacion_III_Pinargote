          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nuevoUsuario\",\n  \"email\": \"nuevo@test.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "GET All Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET User By Id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{userId}}"
          }
        },
        {
          "name": "PUT Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuarioActualizado\"\n}"
            }
          }
        },
        {
          "name": "PUT Upload Profile Image",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/{{userId}}/profile",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "profile", "type": "file", "src": [] }
              ]
            }
          }
        },
        {
          "name": "DELETE User",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/{{userId}}"
          }
        }
      ]
    },
